#!/usr/bin/env python3
"""Copy to ignored ssh.local.sh, chmod +x, configure your own SSH alias."""
import os
import sys

# SSH uses the FIRST value for most options. Select key auth before the older
# tools' password default. Forward their remaining options before the host.
args = sys.argv[1:]
if not args or len(args) % 2 != 1 or any(args[i] != "-o" for i in range(0, len(args) - 1, 2)):
    raise SystemExit("Expected SSH -o option pairs followed by one remote command")
os.execvp("ssh", ["ssh", "-o", "PubkeyAuthentication=yes", "-o", "BatchMode=yes",
                  *args[:-1], "brick-pro", args[-1]])
